<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %>></title>
</head>
<body>
    <%- include("partials/topNav.ejs") %>
    <h1>Delete <%= game.name %></h1>

    <% if(error) { %>
        <div>Error: <%= error %></div>
    <% } %>

    <form action="/delete/<%= game.id %>/delete" method="POST">
        <label for="password">To delete, enter admin password:</label>
        <input type="password" name="password" id="password">
        <button type="submit">Delete</button>
    </form>

</body>
</html>