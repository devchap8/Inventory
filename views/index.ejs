<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <nav>
        <h2>Genres</h2>
        <ul>
            <% genres.forEach(genre => {%> 
                <li><a href="genre/<%= genre %>"><%= genre.charAt(0).toUpperCase() + genre.slice(1) %></a></li>
            <% }) %>
        </ul>
    </nav>
    <%- include("partials/gameDisplay.ejs", {games: games, genre: "All"}) %>
</body>
</html>