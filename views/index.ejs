<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1>Games Inventory</h1>
    <% if(locals.games) { %>
        <% games.forEach(game => { %>
            <div><%= game.name %></div>
        <% }) %>
    <% } %>
</body>
</html>